<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入您的真实姓名"
            android:textColor="#ff666666"
            android:textSize="13sp"
            android:layout_marginHorizontal="44dp"
            android:layout_marginTop="31dp"
            android:paddingVertical="8dp"
            android:gravity="center_horizontal"
            android:background="@drawable/shape_d1d1d1_360radius" />

        <EditText
            android:id="@+id/bank_card_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入您的银行卡号"
            android:textColor="#ff666666"
            android:textSize="13sp"
            android:inputType="number"
            android:layout_marginHorizontal="44dp"
            android:layout_marginTop="20dp"
            android:paddingVertical="8dp"
            android:gravity="center_horizontal"
            android:background="@drawable/shape_d1d1d1_360radius" />

        <EditText
            android:id="@+id/bank_card_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入银行卡名称"
            android:textColor="#ff666666"
            android:textSize="13sp"
            android:layout_marginHorizontal="44dp"
            android:layout_marginTop="20dp"
            android:paddingVertical="8dp"
            android:gravity="center_horizontal"
            android:background="@drawable/shape_d1d1d1_360radius" />

        <EditText
            android:id="@+id/account_bank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入开户行"
            android:textColor="#ff666666"
            android:textSize="13sp"
            android:layout_marginHorizontal="44dp"
            android:layout_marginTop="20dp"
            android:paddingVertical="8dp"
            android:gravity="center_horizontal"
            android:background="@drawable/shape_d1d1d1_360radius" />

        <TextView
            android:id="@+id/next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="确定"
            android:textColor="#ffffffff"
            android:textSize="13sp"
            android:paddingVertical="8dp"
            android:gravity="center_horizontal"
            android:background="@drawable/shape_4acfff_360radius"
            android:layout_marginHorizontal="44dp"
            android:layout_marginBottom="18dp"
            app:layout_constraintVertical_bias="1"
            android:layout_marginTop="45dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>