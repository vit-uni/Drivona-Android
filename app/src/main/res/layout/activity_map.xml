<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_splash">


    <fragment
        android:id="@+id/map"
        class="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/nav_info_frame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleBar" />

    <com.drivona.speed.widght.StatusBarView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:sbv_single_state="true" />


    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_map_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleBar" />

    <TextView
        android:id="@+id/et_search"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_map_search_bg"
        android:drawableEnd="@drawable/ic_map_search_icon"
        android:gravity="center_vertical"
        android:hint="@string/search_for_a_destination"
        android:imeOptions="actionSearch"
        android:paddingStart="10dp"
        android:paddingEnd="28dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="#47FFFFFF"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_back"
        app:layout_constraintTop_toTopOf="@id/iv_back" />

    <LinearLayout
        android:id="@+id/ll_moni"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_search">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="lat" />

        <EditText
            android:id="@+id/et_lat"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:digits="0123456789."
            android:inputType="numberDecimal"
            />

        <TextView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="lng" />

        <EditText
            android:id="@+id/et_lng"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:digits="0123456789."
            android:inputType="numberDecimal"
              />

        <Button
            android:id="@+id/tv_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存" />

        <Button
            android:id="@+id/tv_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_location1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/selector_map_location"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_search" />

    <ImageView
        android:id="@+id/iv_camera1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/selector_map_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_location1" />


    <com.hjq.shape.layout.ShapeConstraintLayout
        android:id="@+id/cl_location_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shape_solidColor="#030C17"
        app:shape_topLeftRadius="13dp"
        app:shape_topRightRadius="13dp">

        <View
            android:layout_width="78dp"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dialog_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="37dp"
            android:src="@drawable/ic_loacation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_location_name" />

        <ImageView
            android:id="@+id/iv_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="37dp"
            android:src="@drawable/ic_loaction_add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_location_name" />

        <TextView
            android:id="@+id/tv_location_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginTop="27dp"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@id/iv_add"
            app:layout_constraintStart_toEndOf="@id/iv_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_location_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#40FFFFFF"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/iv_add"
            app:layout_constraintStart_toStartOf="@id/tv_location_name"
            app:layout_constraintTop_toBottomOf="@id/tv_location_name" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tv_route"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:layout_marginEnd="34dp"
            android:layout_marginBottom="20dp"
            android:drawableStart="@drawable/ic_route"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:paddingVertical="17dp"
            android:text="@string/view_route"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_location_desc"
            app:shape_radius="13dp"

            app:shape_solidColor="#1AFFFFFF" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tv_navigate"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="37dp"
            android:layout_marginEnd="12dp"
            android:drawableStart="@drawable/ic_navigate"
            android:drawablePadding="21dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/navigate_here"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/tv_route"
            app:layout_constraintEnd_toStartOf="@id/tv_route"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_route"
            app:shape_radius="13dp"
            app:shape_solidColor="#003CB3" />

    </com.hjq.shape.layout.ShapeConstraintLayout>

    <com.hjq.shape.layout.ShapeConstraintLayout
        android:id="@+id/cl_routes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="17dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shape_solidColor="#030C17"
        app:shape_topLeftRadius="13dp"
        app:shape_topRightRadius="13dp">

        <com.hjq.shape.layout.ShapeConstraintLayout
            android:id="@+id/cl_routes_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="13dp"
            app:shape_solidColor="#4DFFFFFF">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rec_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


        </com.hjq.shape.layout.ShapeConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rec_routes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            app:layout_constraintTop_toBottomOf="@id/cl_routes_top" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tv_start_navigate"
            android:layout_width="0dp"
            android:layout_height="46dp"

            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="@string/start_navigation"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rec_routes"
            app:shape_radius="13dp"
            app:shape_solidColor="#003CB3" />

        <TextView
            android:id="@+id/tv_route_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="70dp"
            android:text="@string/calculating_route"
            android:textColor="@color/white90"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_routes_top" />
    </com.hjq.shape.layout.ShapeConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>