<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ui.activity.login.LoginActivity">


    <com.drivona.speed.widght.StatusBarView
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:sbv_single_state="true" />

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="49dp"
        android:layout_height="49dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        android:src="@mipmap/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_bar" />

    <TextView
        android:id="@+id/t1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:text="@string/manage_email_address"
        android:textColor="@color/white90"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_back" />

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="11dp"
        android:text="@string/this_email_is_linked_to_your"
        android:textColor="@color/white90"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/t1" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tv_email"
        android:layout_width="wrap_content"
        android:layout_height="47dp"
        android:gravity="center"
        android:paddingHorizontal="30dp"
        android:textColor="@color/white90"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/tv_update_desc1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_desc"
        app:shape_radius="13dp"
        app:shape_solidColor="#001A4D" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tv_update"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:layout_marginHorizontal="17dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:paddingHorizontal="30dp"
        android:text="@string/want_to_change_it"
        android:textColor="@color/white90"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tv_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shape_radius="13dp"
        app:shape_solidColor="#003CB3" />

    <TextView
        android:id="@+id/tv_update_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="17dp"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:text="@string/tap_the_button_below"
        android:textColor="@color/white90"
        android:textSize="13sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/tv_update"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_update_desc1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="17dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:text="@string/want_to_change_it"
        android:textColor="@color/white90"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tv_update_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tv_delete"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:layout_marginHorizontal="17dp"
        android:layout_marginBottom="50dp"
        android:gravity="center"
        android:paddingHorizontal="30dp"
        android:text="@string/delete_account"
        android:textColor="@color/white90"
        android:textSize="13sp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shape_radius="13dp"
        app:shape_solidColor="#360000" />
</androidx.constraintlayout.widget.ConstraintLayout>