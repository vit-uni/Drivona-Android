<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginEnd="11dp"
    android:paddingHorizontal="8dp">

    <ImageView
        android:id="@+id/iv_dot_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/tv_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_name" />

    <View
        android:id="@+id/line_bottom"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dash_v"
        android:layerType="software"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/iv_dot_start"
        app:layout_constraintStart_toStartOf="@id/iv_dot_start"
        app:layout_constraintTop_toTopOf="@id/iv_dot_start" />

    <View
        android:id="@+id/line_top"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dash_v"
        android:layerType="software"
        app:layout_constraintBottom_toBottomOf="@id/iv_dot_start"
        app:layout_constraintEnd_toEndOf="@id/iv_dot_start"
        app:layout_constraintStart_toStartOf="@id/iv_dot_start"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="33dp"
        android:drawableEnd="@drawable/ic_route_add_arrow"
        android:singleLine="true"
        android:text="Route 1"
        android:textColor="#ffffffff"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <ImageView
        android:id="@+id/iv_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginEnd="5dp"
        android:singleLine="true"
        android:background="@drawable/ic_route_add"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#94FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_name"
        app:layout_constraintStart_toStartOf="@id/tv_name" />
</androidx.constraintlayout.widget.ConstraintLayout>
