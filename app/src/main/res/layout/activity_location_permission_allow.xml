<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ui.activity.login.LoginActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/ic_location_permission_allow_bg"
        android:scaleType="centerCrop" />


    <View
        android:id="@+id/view_line"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_dot_theme"
        app:layout_constraintBottom_toBottomOf="@id/tv_success_desc"
        app:layout_constraintStart_toStartOf="@id/tv_connect"
        app:layout_constraintTop_toTopOf="@id/tv_success_desc" />

    <View

        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_dot_theme"
        app:layout_constraintBottom_toBottomOf="@id/tv_success_desc1"
        app:layout_constraintStart_toStartOf="@id/tv_connect"
        app:layout_constraintTop_toTopOf="@id/tv_success_desc1" />

    <View

        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_dot_theme"
        app:layout_constraintBottom_toBottomOf="@id/tv_success_desc2"
        app:layout_constraintStart_toStartOf="@id/tv_connect"
        app:layout_constraintTop_toTopOf="@id/tv_success_desc2" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#ED5700"
        app:layout_constraintBottom_toTopOf="@id/view_line"
        app:layout_constraintEnd_toEndOf="@id/view_line"
        app:layout_constraintStart_toStartOf="@id/view_line"
        app:layout_constraintTop_toBottomOf="@id/view_line1" />

    <View
        android:id="@+id/view_line1"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_dot_theme"
        app:layout_constraintBottom_toBottomOf="@id/tv_success_desc3"
        app:layout_constraintStart_toStartOf="@id/tv_connect"
        app:layout_constraintTop_toTopOf="@id/tv_success_desc3" />

    <TextView
        android:id="@+id/tv_success_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="49dp"
        android:text="@string/return_to_the_drivona_app"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/tv_connect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_line" />

    <TextView
        android:id="@+id/tv_success_desc1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="23dp"
        android:text="@string/allow_1"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/tv_success_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_line" />

    <TextView
        android:id="@+id/tv_success_desc2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="23dp"
        android:text="@string/allow_2"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/tv_success_desc1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_line" />

    <TextView
        android:id="@+id/tv_success_desc3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="23dp"
        android:text="@string/allow_3"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/tv_success_desc2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_line" />

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="17dp"
        android:layout_marginTop="70dp"
        android:text="@string/automatically_connect_to_drivona"
        android:textColor="@color/white"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_desc1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="17dp"
        android:layout_marginTop="7dp"
        android:text="@string/allow_drivona_to_connect_to_your"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@id/tv_desc" />

    <TextView
        android:id="@+id/tv_connect"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:layout_marginHorizontal="17dp"
        android:layout_marginBottom="34dp"
        android:background="@drawable/bg_login_btn_16"
        android:gravity="center"
        android:text="@string/turn_on_auto_connect"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>