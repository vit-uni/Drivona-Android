<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">


    <com.drivona.speed.widght.StatusBarView
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:sbv_single_state="true" />

    <ImageView
        android:id="@+id/tv_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_logo_letter"
        app:layout_constraintBottom_toBottomOf="@id/iv_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_back" />

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="17dp"
        android:layout_marginTop="36dp"

        android:src="@mipmap/ic_add_map_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="17dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/CircleStyle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="524dp"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/ll_dot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/view_pager">

                <com.drivona.speed.widght.DotBarViewPagerIndicator
                    android:id="@+id/pageIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp" />

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/rl_in"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/view_pager">

                <com.drivona.speed.widght.DrawableIndicator
                    android:id="@+id/indicator_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true" />

            </RelativeLayout>

            <com.hjq.shape.view.ShapeTextView
                android:id="@+id/tv_reconnect"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="@string/reconnect"

                android:textColor="@color/white90"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rl_in"
                app:shape_radius="16dp"
                app:shape_solidColor="#003CB3" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_set"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/rl_in">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_notice"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="16dp"
                    android:background="#121317"
                    app:layout_constraintEnd_toStartOf="@id/iv_update"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearance="@style/Round20Style" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_main_notice_icon"
                    app:layout_constraintBottom_toBottomOf="@id/iv_notice"
                    app:layout_constraintEnd_toEndOf="@id/iv_notice"
                    app:layout_constraintStart_toStartOf="@id/iv_notice"
                    app:layout_constraintTop_toTopOf="@id/iv_notice"
                    app:shapeAppearance="@style/Round20Style" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_update"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="11dp"
                    android:background="#121317"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@id/iv_light"
                    app:layout_constraintStart_toEndOf="@id/iv_notice"
                    app:layout_constraintTop_toTopOf="@id/iv_notice"
                    app:shapeAppearance="@style/Round20Style" />


                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_light"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="11dp"
                    android:background="@drawable/bg_device_is_light"
                    app:layout_constraintEnd_toStartOf="@id/iv_delete"
                    app:layout_constraintStart_toEndOf="@id/iv_update"
                    app:layout_constraintTop_toTopOf="@id/iv_notice"
                    app:shapeAppearance="@style/Round20Style" />

                <ImageView
                    android:id="@+id/iv_light_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_main_light_icon"
                    app:layout_constraintBottom_toBottomOf="@id/iv_light"
                    app:layout_constraintEnd_toEndOf="@id/iv_light"
                    app:layout_constraintStart_toStartOf="@id/iv_light"
                    app:layout_constraintTop_toTopOf="@id/iv_light"
                    app:shapeAppearance="@style/Round20Style" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_delete"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="16dp"
                    android:background="#121317"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_light"
                    app:layout_constraintTop_toTopOf="@id/iv_notice"
                    app:shapeAppearance="@style/Round20Style" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_main_delete_icon"
                    app:layout_constraintBottom_toBottomOf="@id/iv_delete"
                    app:layout_constraintEnd_toEndOf="@id/iv_delete"
                    app:layout_constraintStart_toStartOf="@id/iv_delete"
                    app:layout_constraintTop_toTopOf="@id/iv_delete"
                    app:shapeAppearance="@style/Round20Style" />

                <com.hjq.shape.layout.ShapeConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="11dp"
                    app:layout_constraintTop_toBottomOf="@id/iv_notice"
                    app:shape_solidColor="#121317"
                    app:shape_topLeftRadius="14dp"
                    app:shape_topRightRadius="14dp">


                    <com.hjq.shape.layout.ShapeConstraintLayout
                        android:id="@+id/cl_device_02"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="17dp"
                        android:padding="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shape_radius="20dp"
                        app:shape_solidColor="#1B1D23">

                        <TextView
                            android:id="@+id/tv_set_0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:text="@string/screen_brightness"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_set_0_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/adjust_display_brightness"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_set_0" />

                        <SeekBar
                            android:id="@+id/seekbar_0"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginTop="14dp"
                            android:max="4"
                            android:maxHeight="42dp"
                            android:minHeight="42dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:progress="5"
                            android:progressDrawable="@drawable/seekbarbackground"
                            android:splitTrack="false"
                            android:thumb="@drawable/ic_seek_thumb_new"
                            android:thumbOffset="0dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_set_0_desc" />

                        <TextView
                            android:id="@+id/tv_seekbar_0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/seekbar_0"
                            app:layout_constraintEnd_toEndOf="@id/seekbar_0"
                            app:layout_constraintTop_toTopOf="@id/seekbar_0" />

                        <TextView
                            android:id="@+id/tv_set_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/warning_light_brightness"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekbar_0" />

                        <TextView
                            android:id="@+id/tv_set_1_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/adjust_warning_light_brightness"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_set_1" />

                        <SeekBar
                            android:id="@+id/seekbar_1"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginTop="14dp"
                            android:max="4"
                            android:maxHeight="42dp"
                            android:minHeight="42dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:progress="5"
                            android:progressDrawable="@drawable/seekbarbackground"
                            android:thumb="@drawable/ic_seek_thumb_new"
                            android:thumbOffset="0dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_set_1_desc" />

                        <TextView
                            android:id="@+id/tv_seekbar_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/seekbar_1"
                            app:layout_constraintEnd_toEndOf="@id/seekbar_1"
                            app:layout_constraintTop_toTopOf="@id/seekbar_1" />
                    </com.hjq.shape.layout.ShapeConstraintLayout>

                    <com.hjq.shape.layout.ShapeConstraintLayout
                        android:id="@+id/cl_device_01"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="17dp"
                        android:layout_marginTop="10dp"
                        android:padding="10dp"
                        app:layout_constraintTop_toBottomOf="@id/cl_device_02"
                        app:shape_radius="20dp"
                        app:shape_solidColor="#1B1D23">

                        <TextView
                            android:id="@+id/tv_set_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:text="@string/alert_volume"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_set_2_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/adjust_alert_volume"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_set_2" />

                        <SeekBar
                            android:id="@+id/seekbar_2"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginTop="14dp"
                            android:max="10"
                            android:maxHeight="42dp"
                            android:minHeight="42dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:progress="5"
                            android:progressDrawable="@drawable/seekbarbackground"
                            android:thumb="@drawable/ic_seek_thumb_new"
                            android:thumbOffset="0dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_set_2_desc" />

                        <TextView
                            android:id="@+id/tv_seekbar_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/seekbar_2"
                            app:layout_constraintEnd_toEndOf="@id/seekbar_2"
                            app:layout_constraintTop_toTopOf="@id/seekbar_2" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_01"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/seekbar_2">

                            <TextView
                                android:id="@+id/tv_set_11"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:text="@string/warning_light_brightness"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_set_11_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="@string/adjust_warning_light_brightness"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_set_11" />

                            <SeekBar
                                android:id="@+id/seekbar_11"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_marginTop="14dp"
                                android:max="4"
                                android:maxHeight="42dp"
                                android:minHeight="42dp"
                                android:paddingStart="0dp"
                                android:paddingEnd="0dp"
                                android:progress="5"
                                android:progressDrawable="@drawable/seekbarbackground"
                                android:thumb="@drawable/ic_seek_thumb_new"
                                android:thumbOffset="0dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_set_11_desc" />

                            <TextView
                                android:id="@+id/tv_seekbar_11"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="10dp"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="@id/seekbar_11"
                                app:layout_constraintEnd_toEndOf="@id/seekbar_11"
                                app:layout_constraintTop_toTopOf="@id/seekbar_11" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.hjq.shape.layout.ShapeConstraintLayout>

                </com.hjq.shape.layout.ShapeConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>