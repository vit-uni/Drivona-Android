<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_splash" >

    <com.drivona.speed.widght.StatusBarView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:sbv_single_state="true" />


    <TextView
        android:id="@+id/tv_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Navigation Settings"
        android:textColor="@color/color_splash_title"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/iv_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_back" />



    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleBar" />
    <TextView
        android:id="@+id/tv_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="Route Options"
        android:textColor="@color/color_splash_title"
        android:textSize="16sp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_back" />

    <TextView
        android:id="@+id/tv_zh"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginHorizontal="21dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/selector_lauguage_bg"
        android:gravity="center_vertical"
        android:paddingStart="33dp"
        android:text="Avoid toll booths"
        android:textColor="@color/color_splash_title"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_2" />

    <TextView
        android:id="@+id/tv_en"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginHorizontal="21dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/selector_lauguage_bg"
        android:gravity="center_vertical"
        android:paddingStart="33dp"
        android:text="Avoid highways"
        android:textColor="@color/color_splash_title"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_zh" />

    <TextView
        android:id="@+id/tv_deutsh"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginHorizontal="21dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/selector_lauguage_bg"
        android:gravity="center_vertical"
        android:paddingStart="33dp"
        android:text="Avoid the ferry"
        android:textColor="@color/color_splash_title"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_en" />

    <ImageView
        android:id="@+id/iv_zh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="25dp"
        android:src="@drawable/ic_lauguage_select_icon"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_zh"
        app:layout_constraintEnd_toEndOf="@id/tv_zh"
        app:layout_constraintTop_toTopOf="@id/tv_zh" />

    <ImageView
        android:id="@+id/iv_en"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="25dp"
        android:src="@drawable/ic_lauguage_select_icon"
        app:layout_constraintBottom_toBottomOf="@id/tv_en"
        app:layout_constraintEnd_toEndOf="@id/tv_en"
        app:layout_constraintTop_toTopOf="@id/tv_en" />

    <ImageView
        android:id="@+id/iv_deutsh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="25dp"
        android:src="@drawable/ic_lauguage_select_icon"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_deutsh"
        app:layout_constraintEnd_toEndOf="@id/tv_deutsh"
        app:layout_constraintTop_toTopOf="@id/tv_deutsh" />
    <TextView
        android:id="@+id/tv_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="Alarm Settings"
        android:textColor="@color/color_splash_title"
        android:textSize="16sp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_deutsh" />
    <TextView
        android:id="@+id/tv_alarm"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginHorizontal="21dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/selector_lauguage_bg"
        android:gravity="center_vertical"
        android:paddingStart="33dp"
        android:text="Prompt pop-up window"
        android:textColor="@color/color_splash_title"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_3" />

    <com.hjq.widget.view.SwitchButton
        android:id="@+id/sw_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="25dp"
        app:layout_constraintBottom_toBottomOf="@id/tv_alarm"
        app:layout_constraintEnd_toEndOf="@id/tv_alarm"
        app:layout_constraintTop_toTopOf="@id/tv_alarm" />
</androidx.constraintlayout.widget.ConstraintLayout>