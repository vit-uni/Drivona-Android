<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@mipmap/ic_help_02_3"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@id/cl_notice"
        app:layout_constraintDimensionRatio="430:180"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_logo" />

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_logo_letter"
        app:layout_constraintBottom_toBottomOf="@id/tv_skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_skip" />


    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tv_skip"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="37dp"
        android:layout_marginEnd="17dp"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingVertical="13dp"
        android:singleLine="true"
        android:text="@string/skip"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shape_radius="14dp"
        app:shape_solidColor="#4D4D4D" />

    <View
        android:id="@+id/view_line"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:layout_marginVertical="4dp"
        android:background="@drawable/bg_dot_line"
        app:layout_constraintBottom_toBottomOf="@id/tv_success_desc"
        app:layout_constraintStart_toStartOf="@id/tv_pre"
        app:layout_constraintTop_toTopOf="@id/tv_success_desc" />

    <TextView
        android:id="@+id/tv_success_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="14dp"
        android:text="@string/this_box_displays_the_device"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/tv_connect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_line" />

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="17dp"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="14dp"
        android:text="@string/device_settings_area"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintBottom_toTopOf="@id/tv_success_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tv_pre"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="30dp"
        android:gravity="center"
        android:text="@string/previous"
        android:textColor="@color/white90"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/tv_connect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_connect"
        app:shape_radius="13dp"
        app:shape_strokeColor="@color/theme_color"
        app:shape_strokeWidth="1dp" />

    <TextView
        android:id="@+id/tv_connect"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:layout_marginEnd="17dp"
        android:layout_marginBottom="34dp"
        android:background="@drawable/bg_login_btn_16"
        android:gravity="center"
        android:text="@string/next"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_pre" />

    <com.hjq.shape.layout.ShapeConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="17dp"
        android:padding="16dp"
        android:id="@+id/cl_notice"
        android:layout_marginBottom="50dp"
        app:layout_constraintBottom_toTopOf="@id/tv_desc"
        app:shape_radius="13dp"
        app:shape_solidColor="#14171B">

        <ImageView
            android:id="@+id/iv_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_help_ye" />

        <TextView
            android:id="@+id/tv_notice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/day_night_mode"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_0"
            app:layout_constraintTop_toTopOf="@id/iv_0" />

        <TextView
            android:id="@+id/tv_notice_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/switch_to_night_mode_in_low_light_conditions"
            android:textColor="@color/white"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_notice"
            app:layout_constraintTop_toBottomOf="@id/tv_notice" />

    </com.hjq.shape.layout.ShapeConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>